PORT=5000
MONGO_URI=
SESSION_SECRET=
FRONTEND_URL=

# ============================================================
# ML Optimizer Service — internal, never exposed publicly
# Runs on the same EC2 instance on port 8000
# ============================================================
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=

# ============================================================
# JaaS (Jitsi as a Service) — 8x8.vc Live Classroom
# Get credentials from: https://jaas.8x8.vc/#/apikeys
# ============================================================
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY=
JAAS_DOMAIN=8x8.vc

# ============================================================
# Runtime
# ============================================================
# Set to 'production' on EC2. Leave unset or 'development' locally.
NODE_ENV=production
