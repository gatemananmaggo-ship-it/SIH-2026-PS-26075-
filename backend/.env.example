PORT=5000
MONGO_URI=
SESSION_SECRET=
FRONTEND_URL=

# ============================================================
# JaaS (Jitsi as a Service) — 8x8.vc Live Classroom
# Get credentials from: https://jaas.8x8.vc/#/apikeys
# ============================================================
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY=
